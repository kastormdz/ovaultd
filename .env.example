# ovaultd — variables del despliegue con compose.
#   cp .env.example .env && chmod 600 .env
#
# Acá NO hay secretos del servidor (no existen: la auth es por password de cada cuenta contra
# la base, y el server nunca ve claves de vault). El 600 es higiene, no requisito.

# Imagen. Desarrollo: se construye local (ovaultd:dev via docker/compose.dev.yaml).
# Distribución: SIEMPRE repositorio@sha256:<digest> de una imagen publicada REAL — nunca un
# digest inventado (el build-plan lo prohíbe explícitamente).
OVAULTD_IMAGE=ovaultd:local

# Dónde publica el host. 127.0.0.1 => solo el proxy local (recomendado).
# Para un proxy en otra máquina: 0.0.0.0 (el server NO trae TLS: el TLS lo termina el proxy).
OVAULTD_ADDR=127.0.0.1
OVAULTD_PORT=8080

# Puerto del nginx del overlay de desarrollo.
OVAULTD_PROXY_PORT=8888

# Datos: por defecto, volumen nombrado `ovaultd-datos`. Para bind mount:
# OVAULTD_DATA=/srv/ovaultd/datos
# OVAULTD_DATA=

# TTLs.
OVAULTD_TOKEN_TTL_HOURS=720    # sesiones de device: 30 días
OVAULTD_CHALLENGE_TTL=300      # challenges de /access: 5 minutos
OVAULTD_UPLOAD_TTL_HOURS=24    # subidas reanudables sin actividad (renueva con cada bloque)

# Logs: 1 = JSON (compose/distribución), 0 = texto legible (dev a mano).
OVAULTD_LOG_JSON=1
# OVAULTD_LOG=info             # EnvFilter de tracing (ej. "info,ovaultd_server=debug")

# Límites del contenedor.
OVAULTD_MEM_LIMIT=512m
OVAULTD_CPUS=2
