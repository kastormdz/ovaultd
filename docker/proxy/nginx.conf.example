# ---------------------------------------------------------------------------
# Proxy reverso de ejemplo para ovaultd (nginx).
#
# En el overlay de desarrollo (docker/compose.dev.yaml) este archivo se monta
# TAL CUAL en el nginx de compose y `ovaultd` resuelve por la red interna.
# Bare-metal: cambiá el upstream a 127.0.0.1:8080 (o donde escuche ovaultd) y
# poné TLS adelante (el server NO trae TLS: lo termina el proxy).
#
# Los TRES puntos que no se pueden perder detrás de un proxy:
#   1. Host: `POST /access` devuelve el `Host` que ve el server. Si el proxy lo
#      reescribe, el cliente guarda una URL interna y no vuelve a conectar.
#      nginx necesita `proxy_set_header Host $host;` explícito.
#   2. WebSocket (/api/v1/ws): Upgrade/Connection + timeouts de vida larga (la
#      conexión queda abierta escuchando revisiones).
#   3. Tamaño: los bloques de la subida reanudable llegan hasta MAX_FILE_BYTES
#      (32 MiB). El default de nginx (`client_max_body_size 1m`) los corta con
#      413 ANTES de que el server los vea.
# ---------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ovaultd_upstream {
    server ovaultd:8080;   # bare-metal: 127.0.0.1:8080
}

server {
    listen 80;
    server_name _;

    client_max_body_size 40m;        # > 32 MiB + overhead de JSON/frames
    proxy_request_buffering off;     # los PATCH reanudables hacen streaming, no van a disco de nginx
    proxy_read_timeout 1h;           # /api/v1/ws es de vida larga
    proxy_send_timeout 1h;

    location / {
        proxy_pass http://ovaultd_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;                              # 1) OBLIGATORIO
        proxy_set_header Upgrade $http_upgrade;                   # 2)
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Operación: /metrics solo para redes privadas (la red de compose es 172.x).
    location = /metrics {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://ovaultd_upstream;
        proxy_set_header Host $host;
    }
}
